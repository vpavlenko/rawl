--- public/src/components/rawl/noteCents.ts
+++ release/src/components/rawl/noteCents.ts
@@ -0,0 +1,14 @@
+import { getTonic } from "./analysis";
+import type { Analysis } from "./analysis";
+import type { Note } from "./parseMidi";
+import { getNotePitchAtTime } from "./pitchBend";
+
+export function getNoteCentsFromTonic(
+  note: Note, time: number, analysis: Analysis, measures: number[],
+): number | null {
+  if (note.isDrum) return null;
+  const tonic = getTonic((note.span[0] + note.span[1]) / 2, analysis, measures);
+  if (tonic == null) return null;
+  const cents = Math.round((getNotePitchAtTime(note, time) - tonic) * 100);
+  return Number.isFinite(cents) ? (((cents + 450) % 1200) + 1200) % 1200 - 450 : null;
+}
--- public/src/components/rawl/NoteCentsTooltip.tsx
+++ release/src/components/rawl/NoteCentsTooltip.tsx
@@ -0,0 +1,31 @@
+import * as React from "react";
+import { createPortal } from "react-dom";
+
+export default function NoteCentsTooltip({ cents, x, y }: {
+  cents: number; x: number; y: number;
+}) {
+  return createPortal(
+    <div
+      role="tooltip"
+      style={{
+        position: "fixed",
+        left: Math.max(4, Math.min(x + 12, window.innerWidth - 76)),
+        top: Math.max(4, Math.min(y + 12, window.innerHeight - 32)),
+        zIndex: 100000001,
+        pointerEvents: "none",
+        padding: "4px 7px",
+        border: "1px solid #666",
+        borderRadius: 4,
+        background: "#111",
+        color: "white",
+        fontSize: 13,
+        lineHeight: "18px",
+        fontVariantNumeric: "tabular-nums",
+        whiteSpace: "nowrap",
+      }}
+    >
+      {cents}¢
+    </div>,
+    document.body,
+  );
+}
