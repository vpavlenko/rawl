{
  "checkedAt": "2026-10-27",
  "sources": [
    {
      "name": "Copista / copisteria",
      "url": "https://huggingface.co/kobimusic/copista-28m",
      "code": "https://github.com/kobimusic/copisteria",
      "architecture": "symbol detector plus learned structural evidence model",
      "decision": "Include as independent diagnostic engine; local five-page pilot completed; do not automatically accept clefs or tremolos"
    },
    {
      "name": "page-omr",
      "url": "https://github.com/tobiashornbogen/page-omr",
      "paper": "https://ismir2026program.ismir.net/poster_520.html",
      "architecture": "full-page DINOv2 encoder and autoregressive decoder to kern or ABC",
      "decision": "Include as independent full-page diagnostic engine; first-page control successful"
    },
    {
      "name": "Transcoda",
      "url": "https://github.com/btrkeks/transcoda",
      "paper": "https://arxiv.org/abs/2605.10835",
      "architecture": "ConvNeXtV2 plus autoregressive kern decoder",
      "decision": "Useful next candidate for piano pair and historical scans; not run"
    },
    {
      "name": "SMT / SMT++ / SMT NeXt",
      "url": "https://github.com/antoniorv6/SMT",
      "paper": "https://doi.org/10.1007/s11263-025-02654-6",
      "architecture": "image-to-sequence transformer with system and full-page pianoform checkpoints",
      "decision": "Reserve independent baseline; SMT++ repository migrated to SMT; not run"
    },
    {
      "name": "LEGATO 2",
      "url": "https://huggingface.co/guangyangmusic/legato-2",
      "paper": "https://arxiv.org/abs/2607.05769",
      "architecture": "system detector and sequential context-conditioned ABC transcriber",
      "decision": "Checkpoint now published but gated; terms not accepted and not run"
    },
    {
      "name": "Starry",
      "url": "https://github.com/FindLab-org/starry",
      "paper": "https://arxiv.org/abs/2604.20522",
      "architecture": "symbol candidates plus topology recognition and probability-guided structure search",
      "decision": "Relevant to timing/voice separation; public repository says core code release is pending; not run"
    }
  ],
